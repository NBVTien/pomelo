flowchart TB
    classDef client fill:#1f2a44,stroke:#5b7cc9,color:#dce6ff,stroke-width:1.5px
    classDef bar fill:#2a2436,stroke:#8a6fc9,color:#e6dcff,stroke-width:1.5px
    classDef seam fill:#173a2e,stroke:#4bab7f,color:#d6f5e6,stroke-width:1.5px
    classDef app fill:#3a3417,stroke:#c9a94b,color:#f5efd6,stroke-width:1.5px
    classDef core fill:#26313f,stroke:#6f8fc9,color:#dbe6ff,stroke-width:1.5px
    classDef infra fill:#3a1f2a,stroke:#c95b7c,color:#ffd6e6,stroke-width:1.5px

    subgraph CLIENTS["CLIENTS — thin: parse → call → render (no business logic)"]
        direction LR
        APP["macOS app<br/><b>SwiftUI</b><br/>Views + ViewModels"]:::client
        CLI["<b>pom</b> CLI<br/>cmd/pom"]:::client
        MCP["<b>pom mcp</b><br/>agent tools"]:::client
        APP ~~~ CLI ~~~ MCP
    end

    FFI["libpom FFI — typed <b>//export</b> bindings + <b>PomStream</b> · in-process, no port<br/><i>pom mcp builds the /api handler in-process from the same core</i>"]:::bar

    subgraph CORE["CORE — internal/core Server · ONE impl, many callers"]
        direction TB
        subgraph SEAMS["Provider seams — add a provider = new file, not a core change"]
            direction LR
            TRK["tracker<br/><i>Jira</i>"]:::seam
            FRG["forge<br/><i>GitHub API</i>"]:::seam
            DB["dbclient"]:::seam
            SH["shell"]:::seam
            AG["agent<br/><i>Claude</i>"]:::seam
            TRK ~~~ FRG ~~~ DB ~~~ SH ~~~ AG
        end
        subgraph APPL["Application — use-cases / orchestration"]
            direction LR
            PIPE["pipeline<br/>workspace lifecycle"]:::app
            CMDS["commands<br/>operations"]:::app
            PIPE ~~~ CMDS
        end
        subgraph SHARED["Domain + shared"]
            direction LR
            CFG["config<br/>schema · {{var}} · validate"]:::core
            HX["httpx · workspace<br/>services helpers"]:::core
            CFG ~~~ HX
        end
        SEAMS ~~~ APPL ~~~ SHARED
    end

    INFRA["INFRASTRUCTURE — side effects · docker · git · ptyhost (PTY holders) · ports/net · filesystem"]:::infra

    CLIENTS <--> FFI
    FFI <--> CORE
    CORE <--> INFRA

    RULE["RULE: dependencies point INWARD only — app · CLI · mcp are 3 clients of ONE core.<br/>Guarded by internal/arch/deps_test.go"]:::bar
    RULE -.-> CLIENTS
